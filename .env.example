# Copy to .env and fill in. Never commit .env.
# Server (Express API and the seed script)
SUPABASE_URL=
SUPABASE_ANON_KEY=
# Only for `npm run seed`. Keep it local and never add it to Vercel or the client.
SUPABASE_SERVICE_ROLE_KEY=
# OneMap routing token (https://www.onemap.gov.sg). Optional: without it, travel times are hidden.
ONEMAP_TOKEN=
# Set to 1 during NUS vacation so the shuttle headways match the vacation notice.
NUS_VACATION=

# Client (exposed to the browser, so anon key only)
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
# Set to 1 to run the UI against hardcoded data with no backend.
VITE_MOCK=
